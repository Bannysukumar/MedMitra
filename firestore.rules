rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isActiveUser() {
      let status = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus;
      return status == null || status == 'active';
    }

    function isDoctor() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['doctor', 'admin'];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /addresses/{addrId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isOwner(userId) || isAdmin();
      }
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /prescriptions/{rxId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /medicines/{medId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blog/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /team/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pricing/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteStats/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow create: if true;
      allow read, update: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, create: if isAdmin();
    }

    match /announcements/{annId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /emailTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    match /securityLogs/{logId} {
      allow read, create: if isAdmin();
    }

    match /platformSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isActiveUser();
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isOwner(doctorId) || isAdmin();
    }

    match /doctorStats/{doctorId} {
      allow read: if isOwner(doctorId) || isAdmin();
      allow write: if isOwner(doctorId) || isAdmin();
    }

    match /doctorAppointments/{apptId} {
      allow read: if isSignedIn() &&
        (resource.data.doctorId == request.auth.uid || isAdmin());
      allow create: if isDoctor() && request.resource.data.doctorId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (isDoctor() && resource.data.doctorId == request.auth.uid);
    }

    match /medicalFacilities/{facilityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /doctorPatients/{patientId} {
      allow read: if isSignedIn() &&
        (resource.data.doctorId == request.auth.uid || isAdmin());
      allow create: if isDoctor() && request.resource.data.doctorId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (isDoctor() && resource.data.doctorId == request.auth.uid);
    }
  }
}
